{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "sh scripts/verdict.sh go-major node scripts/go-major.mjs '${nextRelease.version}'",
        "prepareCmd": "sh scripts/verdict.sh release-build bash scripts/release-build.sh '${nextRelease.version}'"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "artifacts/release/slicc-*" },
          { "path": "artifacts/release/install.sh", "label": "install.sh" },
          { "path": "artifacts/release/SHA256SUMS", "label": "SHA256SUMS" }
        ]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "sh scripts/verdict.sh npm-publish node scripts/npm-publish.mjs && sh scripts/verdict.sh npm-publish node scripts/npm-publish.mjs --dir dist/npm-next --tag next"
      }
    ]
  ]
}
