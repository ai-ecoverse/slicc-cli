{
  "name": "slicc-cli",
  "version": "0.0.0",
  "private": true,
  "description": "SLICC's command line: launches and links browsers, and shares a machine's network, compute and browsers with seven over WebRTC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-cli.git"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-cli",
    "publish": true,
    "include": [
      "@ai-ecoverse/slicc",
      "@ai-ecoverse/slicc-darwin-arm64",
      "@ai-ecoverse/slicc-darwin-amd64",
      "@ai-ecoverse/slicc-linux-arm64",
      "@ai-ecoverse/slicc-linux-amd64",
      "@ai-ecoverse/slicc-windows-arm64",
      "@ai-ecoverse/slicc-windows-amd64",
      "@ai-ecoverse/wasi-slicc",
      "sliccy"
    ]
  },
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint-comments && slicc-no-unit-tests && slicc-agents-md && test -z \"$(gofmt -l .)\" && go mod tidy -diff && go vet ./... && GOOS=darwin go vet ./... && GOOS=windows go vet ./... && golangci-lint run",
    "lint:sh": "shellcheck -s sh install.sh test/integration/testdata/install/check.sh && shellcheck scripts/*.sh",
    "format": "gofmt -w .",
    "test": "node scripts/test-shard.mjs ci/5 -race -count=1 -timeout 15m -v ./test/integration/...",
    "test:unit": "go test -race -cover ./cmd/... ./internal/...",
    "build": "go build -trimpath -ldflags \"-s -w\" -o bin/slicc ./cmd/slicc",
    "dist": "SLICC_SIGN=0 scripts/package.sh 0.0.0-dev",
    "npm:stage": "node scripts/npm-stage.mjs --version 0.0.0-dev",
    "npm:check": "node scripts/npm-publish.mjs --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-browsers": "1.18.13",
    "@ai-ecoverse/slicc-cdp": "1.41.6",
    "@ai-ecoverse/slicc-kernel": "1.161.0",
    "@ai-ecoverse/slicc-shared-web": "2.12.1",
    "@semantic-release/exec": "7.1.0",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  }
}
